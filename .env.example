# Salin file ini menjadi .env lalu isi. JANGAN commit file .env.

# "mt5" = koneksi ke terminal MetaTrader 5 (Windows saja)
# "mock" = data simulasi, untuk mencoba tanpa MT5
DATA_SOURCE=mock

MT5_LOGIN=12345678
MT5_PASSWORD=isi_password_di_sini
MT5_SERVER=NamaBroker-Demo
# Opsional: lokasi terminal64.exe jika MT5 tidak terdeteksi otomatis
MT5_PATH=

# Akhiran simbol dari broker, misalnya ".m" untuk XAUUSD.m
SYMBOL_SUFFIX=
# Opsional: pemetaan khusus per simbol (JSON), menimpa SYMBOL_SUFFIX
# SYMBOL_MAP={"BTCUSD": "BTCUSD#", "XAUUSD": "GOLD"}
SYMBOL_MAP={}

# Sumber kalender berita, urut prioritas: myfxbook, forexfactory (kosongkan = tanpa filter berita)
NEWS_SOURCES=myfxbook,forexfactory
NEWS_WINDOW_MINUTES=30

# Eksekusi order
DEFAULT_LOT=0.01
# Batas keras lot per order; order di atas ini selalu ditolak
MAX_LOT=0.10
TRADE_DEVIATION_POINTS=20
MAGIC_NUMBER=20261116
# Isi jika dashboard dibuka dari perangkat lain / VPS; browser akan meminta token ini sebelum order
DASHBOARD_TOKEN=

# Auto-Trigger (saklar selalu OFF setiap aplikasi baru dijalankan)
AUTO_MIN_CONFIDENCE=80
AUTO_LOT=0.01
AUTO_INTERVAL_SECONDS=60
AUTO_MAX_OPEN_POSITIONS=3
AUTO_COOLDOWN_MINUTES=60
AUTO_MAX_TRADES_PER_DAY=5
AUTO_MAX_DAILY_LOSS_PERCENT=3
AUTO_MAX_SPREAD_RATIO=0.25
AUTO_SYMBOLS=XAUUSD,BTCUSD,ETHUSD,EURUSD,GBPUSD,USDJPY,AUDUSD
# Auto-Trigger ditolak di akun REAL kecuali ini true. Uji di akun demo dulu.
ALLOW_AUTO_ON_REAL_ACCOUNT=false
